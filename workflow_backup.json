1)throw new Error('invalid_kv');const key=line.slice(0,idx).trim();let val=line.slice(idx+1).trim();if(val===''){current=key;obj[key]=obj[key]||[]}else{current=null;if((val.startsWith('\"')&&val.endsWith('\"'))||(val.startsWith(\"'\")&&val.endsWith(\"'\")))val=val.slice(1,-1);obj[key]=val}}return obj}\nconst REQUIRED=['title','created','updated','tags','status'];\nconst fm=extractFrontMatter(md);const report={has_front_matter:!!fm.yaml,errors:[],warnings:[],fields:{}};let fmObj={};\nif(fm.yaml){try{fmObj=parseSimpleYAML(fm.yaml)}catch(e){report.errors.push(`yaml_parse_error:${e.message}`)}}else{report.errors.push('missing_front_matter')}\nfor(const k of REQUIRED){if(!(k in fmObj))report.errors.push(`missing_${k}`)}\nif(fmObj.tags && !Array.isArray(fmObj.tags))report.errors.push('tags_must_be_array')\nif(fmObj.status && !['draft','active','archived'].includes(String(fmObj.status).toLowerCase()))report.warnings.push('status_unknown')\nconst iso=s=>/^\\d{4}-\\d{2}-\\d{2}/.test(String(s||''));\nif(fmObj.created && !iso(fmObj.created))report.warnings.push('created_not_iso')\nif(fmObj.updated && !iso(fmObj.updated))report.warnings.push('updated_not_iso')\nconst slug=(fmObj.title||'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,'');\nreport.fields={...fmObj,slug,content_preview:fm.content.slice(0,200)}\nconst norm={status:(fmObj.status||'draft').toLowerCase(),tags:Array.isArray(fmObj.tags)?[...new Set(fmObj.tags.map(t=>String(t).trim().toLowerCase()))]:[]}\nreturn [{json:{file_path:$json.filePath||null,audit_ok:report.errors.length===0,audit_report:report,normalized_hint:norm}}];"},"id":"1c3a3cd8-715a-4e62-8f2b-85175a088eab","name":"Audit Front Matter","type":"n8n-nodes-base.function","typeVersion":1,"position":[-912,-16]},{"parameters":{"operation":"executeQuery","query":"INSERT INTO processing_logs (file_path, stage, status, details, created_at) VALUES ($1,$2,$3,$4::jsonb,NOW())","options":{}},"id":"937ed0f6-c935-4218-965f-e9d0639f8981","name":"Log Postgr